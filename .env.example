# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Admin identity ----------
# Numeric GitHub account ID of the owner (NOT the username; usernames can change).
# Find it: https://api.github.com/users/<username>  ->  "id"
ADMIN_GITHUB_ID=

# ---------- GitHub integration ----------
# Optional. A fine-grained PAT with NO extra permissions (public data only)
# raises the API rate limit from 60/h to 5000/h. Leave blank to run unauthenticated.
GITHUB_API_TOKEN=
# Shared secret configured on the GitHub webhook (generate: openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=

# ---------- Scheduled jobs ----------
# Bearer secret Vercel Cron sends to /api/cron/github-sync (generate: openssl rand -hex 32)
CRON_SECRET=
